{
  "name": "blokhouse",
  "version": "0.3.0",
  "description": "Simple, automation-first open source CMDB",
  "homepage": "https://github.com/d4sw4r/blokhouse",
  "repository": {
    "type": "git",
    "url": "https://github.com/d4sw4r/blokhouse.git"
  },
  "keywords": [
    "cmdb",
    "infrastructure",
    "inventory",
    "ansible",
    "puppet",
    "devops"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start:prod": "sh scripts/start.sh",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts",
    "test:integration": "vitest run --config vitest.integration.config.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "^12.6.2",
    "next": "16.4.6",
    "next-auth": "^4.24.11",
    "next-swagger-doc": "^0.5.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-react": "^5.31.2",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
