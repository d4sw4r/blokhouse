{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blokhouse chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "blokhouse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "nextauthSecret": {
          "type": "string"
        },
        "allowSignup": {
          "type": "boolean"
        },
        "passwordLogin": {
          "type": "boolean"
        },
        "sessionMaxAge": {
          "type": [
            "string",
            "integer"
          ]
        },
        "webhookWorker": {
          "type": "boolean"
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "subnet": {
              "type": "string"
            }
          }
        },
        "sso": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "roleClaim": {
              "type": "string"
            },
            "roleMap": {
              "type": "string"
            },
            "defaultRole": {
              "type": "string"
            },
            "trustEmail": {
              "type": [
                "string",
                "boolean"
              ]
            },
            "tokenMaxDays": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "openshift": {
      "type": "boolean"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
