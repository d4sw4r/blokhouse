# Blokhouse Configuration
# Copy this file to .env and fill in your values

# Public URL of your Blokhouse instance
NEXTAUTH_URL=http://localhost:3000

# Random secret for NextAuth — REQUIRED. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# SQLite database path (the Docker image uses file:/app/data/blokhouse.db)
DATABASE_URL=file:./prisma/blokhouse.db

# Initial administrator (only used when no admin exists yet).
# If ADMIN_PASSWORD is empty, a random password is generated and printed once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Allow public self-registration on /signup (new users get the READONLY role)
ALLOW_SIGNUP=false

# Network discovery (admin only, requires nmap in the container/host)
DISCOVERY_ENABLED=false
NETWORK_SUBNET=192.168.1.0/24
DISCOVERY_USE_SUDO=false
