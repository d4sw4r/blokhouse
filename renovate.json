{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates need a human review, including devDependencies",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "eslint-config-next (eslint-plugin-react) does not support ESLint 10 yet",
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Prisma CLI, client and driver adapter must always share one version",
      "matchPackageNames": [
        "prisma",
        "@prisma/client",
        "@prisma/adapter-pg"
      ],
      "groupName": "prisma"
    }
  ],
  "platformAutomerge": true,
  "assignees": [
    "d4sw4r"
  ]
}
